{
  "name": "zoop-github-api",
  "type": "python",
  "build": {
    "command": "cd github_search && pip install -r requirements.txt"
  },
  "run": {
    "command": "cd github_search && uvicorn main:app --host 0.0.0.0 --port 8000"
  },
  "env": {
    "OPENAI_API_KEY": "your-openai-api-key",
    "GITHUB_TOKEN": "your-github-token"
  },
  "ports": [
    8000
  ]
}
